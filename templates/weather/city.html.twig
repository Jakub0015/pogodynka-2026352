{% extends 'base.html.twig' %}

{# @var location \App\Entity\Location #}
{# @var forecast \App\Entity\Forecast[] #}

{% block title %}Weather in {{ location.name }}, {{ location.country }}{% endblock %}

{% block body %}
    <main>
        <h1>Weather in {{ location.name }}, {{ location.country }}</h1>
        <table class="table">
            <thead>
            <tr>
                <th>Date</th>
                <th>Temperature (°C)</th>
                <th>Humidity (%)</th>
                <th>Precipitation (mm)</th>
                <th>Wind (km/h)</th>
            </tr>
            </thead>
            <tbody>
            {% for f in forecast %}
                <tr>
                    <td>{{ f.date|date('Y-m-d') }}</td>
                    <td>{{ f.temperature }}°C</td>
                    <td>{{ f.humidity }}</td>
                    <td>{{ f.precipitation }}</td>
                    <td>{{ f.wind }}</td>
                </tr>
            {% else %}
                <tr><td colspan="5">Brak prognoz</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </main>
{% endblock %}
